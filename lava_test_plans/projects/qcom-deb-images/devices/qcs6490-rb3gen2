{% extends "devices/qcs6490-rb3gen2" %}

{# the ufs flashing stage comes from the common device #}
{% set qdl_image_dir = "flash_qcs6490-rb3gen2-vision-kit_ufs" %}
{% set qdl_rootfs_image = "disk-ufs.img2" %}
{% set qdl_tarball = "flash-ufs.tar.gz" %}

{# ask for the vision kit, an alias of the qcs6490-rb3gen2 device type, #}
{# which also covers the core kit                                       #}
{% block device_type %}qcs6490-rb3gen2-vision-kit{% endblock %}

{# the bluetooth, audio and display plans need a lab fixture this board is #}
{# not known to have, and a job asking for one that no device carries sits #}
{# queued until it times out; drop the entry once the board has it         #}
{% set EXCLUDED_TESTPLANS = [
    'pre-merge-bt.yaml',
    'pre-merge-audio.yaml',
    'pre-merge-display-gfx.yaml'
] %}
