{% extends "devices/shikra-iqs-evk" %}

{# ptool describes two physical partitions for shikra-evk/emmc and emits a  #}
{# rawprogram/patch pair for each: 0 is the main storage, 1 is the JEDEC    #}
{# boot area holding just the CDT. Flash both, so the board also gets the   #}
{# CDT this build was generated against. The common device flashes 0 alone. #}
{% set qdl_stages = [
    {"storage": "emmc", "path": "",
     "rawprogram": "rawprogram0.xml rawprogram1.xml",
     "patch": "patch0.xml patch1.xml"}
] %}
{% set qdl_image_dir = "flash_shikra-iqs-evk_emmc" %}
{% set qdl_rootfs_image = "disk-sdcard.img2" %}
{% set qdl_tarball = "flash-emmc.tar.gz" %}

{# WiFi_OnOff needs iw, which the testkit has no debian package mapping for. #}
{# Its installer then takes the warning it logged about that as the name of   #}
{# the package to install and dumps apt's policy for the whole archive down   #}
{# the serial console, using up the whole budget of the test action so that   #}
{# nothing after it runs. Drop it until the testkit is fixed.                 #}
{# The rest are not run on the debian images for now.                         #}
{% set EXCLUDED_TESTS = [
    'WiFi_OnOff',
    'AudioRecord',
    'Docker_Kernel_Config',
    'Kubernetes_Kernel_Config',
    'Logging_Journalctl_Validation'
] %}

{# the bluetooth, audio and display plans need a lab fixture this board is #}
{# not known to have, and a job asking for one that no device carries sits #}
{# queued until it times out; drop the entry once the board has it         #}
{% set EXCLUDED_TESTPLANS = [
    'pre-merge-bt.yaml',
    'pre-merge-audio.yaml',
    'pre-merge-display-gfx.yaml'
] %}
